# Скопируйте в .env на сервере Amvera (переменные в панели проекта)
# ВАЖНО: используйте PostgreSQL, иначе данные будут теряться при пересборке контейнера.
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
SECRET_KEY=сгенерируйте-длинную-случайную-строку
CORS_ORIGINS=https://ваш-фронт.ru,http://localhost:5173

# Онлайн-запись: имена стадий воронки (как в seed). Можно не задавать.
# BOOKING_QUEUE_STAGE_NAME=Квалифицирован
# BOOKING_STAGE_AFTER_BOOK=В работе
# BOOKING_STAGE_COMPLETED=Успешно реализован
# BOOKING_STAGE_LOST=Потерян
# BOOKING_TIMEZONE=Asia/Dushanbe

# SMTP (Gmail, отправка приглашений/тестовых писем)
# Для Gmail нужен пароль приложения (App Password), не обычный пароль аккаунта.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=metoditj@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=metoditj@gmail.com
